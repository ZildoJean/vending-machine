# Point d'entrée unique : sert l'interface (fichiers statiques) ET relaie /api vers le serveur.
# MÊME ORIGINE => cookie SameSite=Strict sans CORS.
#
# SITE_ADDRESS choisit le mode (voir docs/DEPLOIEMENT.md) :
#   localhost                 HTTPS local (autorité interne de Caddy, certificat non reconnu par les navigateurs)
#   machine.duckdns.org       HTTPS public automatique (Let's Encrypt) : ports 80 et 443 joignables depuis Internet
#   http://:8080              HTTP simple, DERRIÈRE un tunnel qui fournit le HTTPS (Tailscale Funnel, Cloudflare Tunnel)
{
	servers {
		# Un tunnel (local, donc privé) peut transmettre X-Forwarded-For : sans cela, toutes les requêtes
		# sembleraient venir de la même adresse et la limitation de débit les regrouperait.
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		# L'interface n'a ni script ni style en ligne (vérifié par un test) : CSP stricte.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		# Sans effet en HTTP simple ; en HTTPS, impose HTTPS pendant un an.
		Strict-Transport-Security "max-age=31536000"
	}

	handle /api/* {
		uri strip_prefix /api
		header Cache-Control "no-store"
		reverse_proxy {$API_UPSTREAM:127.0.0.1:3000}
	}

	handle {
		root * {$WEB_ROOT:/srv}
		# les routes inconnues retombent sur l'application (une seule page)
		try_files {path} /index.html
		file_server
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header / Cache-Control "no-cache"
		header /index.html Cache-Control "no-cache"
	}
}

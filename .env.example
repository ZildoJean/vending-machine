# ===== Copier ce fichier en « .env » (à la racine du projet) : il est lu AUTOMATIQUEMENT par le serveur et par
# ===== les commandes db:migrate, db:roles et seed:admin. Une variable déjà définie dans le terminal reste prioritaire.
# ===== Windows : copy .env.example .env      Linux/macOS : cp .env.example .env

NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Base de données. En DÉVELOPPEMENT, le rôle propriétaire peut servir à tout.
DATABASE_URL=postgres://vending:vending@localhost:5432/vending_dev
# Rôle propriétaire pour les migrations (identique à DATABASE_URL tant que vous n'utilisez pas le rôle restreint)
MIGRATION_DATABASE_URL=postgres://vending:vending@localhost:5432/vending_dev

# Poivre des PIN : 32 caractères minimum, SECRET. À générer (ex. : openssl rand -base64 48, ou node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
# Ne JAMAIS le perdre ni le changer après avoir créé des comptes (tous les PIN deviendraient invalides).
PIN_PEPPER=CHANGE-ME-generer-avec-openssl-rand-base64-48

# Origine EXACTE ouverte dans le navigateur (interface de développement : http://localhost:5173, pas 127.0.0.1)
ALLOWED_ORIGINS=http://localhost:5173
# En développement (http) : false. En production (HTTPS) : true (valeur par défaut).
COOKIE_SECURE=false
LOG_LEVEL=info

# Premier administrateur (commande seed:admin) : mot de passe de 12 caractères minimum
ADMIN_LOGIN=admin
ADMIN_PASSWORD=un-mot-de-passe-d-au-moins-12-caracteres

# OPTIONNEL : rôle applicatif restreint (commande db:roles), puis mettre DATABASE_URL = postgres://vending_app:<mot de passe>@localhost:5432/vending_dev
# APP_DB_PASSWORD=
# APP_DB_ROLE=vending_app

# OPTIONNEL : limites de débit par adresse IP et par minute (valeurs par défaut ci-dessous)
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_GLOBAL_MAX=300
# RATE_LIMIT_DEPOSIT_MAX=60

# Tests : le rôle doit pouvoir CREATE DATABASE (et CREATE ROLE pour le test de séparation des droits)
# TEST_PG_ADMIN_URL=postgres://postgres:motdepasse@localhost:5432/postgres
